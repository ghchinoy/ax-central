// AX Central system architecture: Lit 3 frontend, Wails v2 Go bridge,
// and dual compute substrates (Apple container ate-local vs Kubernetes kind).
digraph ax_central_architecture {
  label = "AX Central · system architecture";
  ranksep = 0.55;
  nodesep = 0.45;
  newrank = true;

  agent [label="WebMCP caller", class="terminal"];

  subgraph cluster_app {
    label = "AX Central desktop app";

    subgraph cluster_ui {
      label = "Lit 3 frontend";
      shell    [label="ax-central", class="primary code"];
      toolhost [label="ToolHost", class="emphasis"];
      stores   [label="Reactive stores"];
    }

    subgraph cluster_bridge {
      label = "Wails v2 Go bridge";
      runner [label="shell.go", class="code"];
      doctor [label="hack/doctor.sh", class="muted code"];
      shim   [label="docker-shim.sh", class="muted code"];
    }
  }

  axcli [label="ax CLI", class="code"];

  subgraph cluster_local {
    label = "Apple container · ate-local";
    class = "accent";
    ax_local  [label="ax-server :8090", class="code"];
    ate_local [label="ate-local :50051", class="emphasis code"];
    pg_local  [label="Postgres :5432", class="store"];
    microvm   [label="ate-* microVMs", class="positive"];
  }

  subgraph cluster_kind {
    label = "Kubernetes · kind";
    ax_k8s  [label="ax-server", class="code"];
    ate_k8s [label="ate-api-server", class="code"];
    workers [label="gVisor workers"];
  }

  {rank=same; shell; toolhost;}
  {rank=same; doctor; shim;}
  {rank=same; ax_local; ax_k8s;}
  {rank=same; ate_local; pg_local; ate_k8s;}
  {rank=same; microvm; workers;}

  agent -> toolhost  [label="modelContext", class="async code"];
  shell -> stores;
  toolhost -> stores;
  stores -> runner   [label="Wails IPC", class="primary"];
  runner -> doctor   [class="muted"];
  runner -> shim     [class="muted"];
  runner -> axcli    [label="exec", class="primary code"];

  axcli -> ax_local  [label="--server :8090", class="primary code"];
  axcli -> ax_k8s    [label="--context kind-*", class="code"];

  ax_local -> pg_local;
  ax_local -> ate_local [label="gRPC", class="code"];
  ate_local -> microvm  [label="vmnet :80", class="positive"];

  ax_k8s -> ate_k8s     [label="gRPC", class="code"];
  ate_k8s -> workers;
}
